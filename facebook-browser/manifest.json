{
  "manifest_version": 3,
  "name": "询盘工作台 · Facebook 评论采集",
  "description": "在当前 Chrome 登录状态下，读取本机工作台已添加帖子的可见评论。",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["alarms", "scripting", "storage"],
  "host_permissions": ["https://www.facebook.com/*", "https://facebook.com/*", "https://m.facebook.com/*", "https://fb.watch/*", "http://127.0.0.1/*"],
  "action": {"default_title": "立即检查工作台的到期帖子"},
  "background": {"service_worker": "worker.js"}
}
